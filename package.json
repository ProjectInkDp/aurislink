{
  "name": "aurislink",
  "version": "1.9.0-dev.f451505",
  "description": "Lavalink v4-compatible audio server in Node.js — SoundCloud + Deezer.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --dns-result-order=ipv4first --import tsx src/index.ts",
    "start:dist": "node --dns-result-order=ipv4first dist/index.js",
    "build": "tsc --incremental false",
    "dev": "node --watch --dns-result-order=ipv4first --import tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@projectinkdp/auris-player": "1.0.6-dev.0bb3412",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "ws": "^8.18.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "husky": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
